Task 1: Set up Kubernetes SDN for Default VM Networking
Subtask 1.1: Understand Default Pod Network
First, let's examine the default networking configuration that VMs will use.

Step 1: Check the current cluster network configuration

oc get network.config cluster -o yaml
Step 2: Examine the default CNI configuration

oc get network.operator cluster -o yaml
Step 3: View available network policies

oc get networkpolicies --all-namespaces
Subtask 1.2: Create a Basic VM with Default Networking
Step 1: Create a new project for our networking lab

oc new-project vm-networking-lab
Step 2: Create a basic VM configuration file

cat > basic-vm.yaml << 'EOF'
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: basic-vm
  namespace: vm-networking-lab
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: basic-vm
    spec:
      domain:
        devices:
          disks:
          - name: containerdisk
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            masquerade: {}
        resources:
          requests:
            memory: 1Gi
            cpu: 1
      networks:
      - name: default
        pod: {}
      volumes:
      - name: containerdisk
        containerDisk:
          image: quay.io/kubevirt/cirros-container-disk-demo
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            password: fedora
            chpasswd: { expire: False }
            ssh_pwauth: True
EOF
Step 3: Apply the VM configuration

oc apply -f basic-vm.yaml
Step 4: Wait for the VM to start and check its status

oc get vm basic-vm
oc get vmi basic-vm
Subtask 1.3: Examine VM Network Configuration
Step 1: Get the VM's pod information

oc get pods -l kubevirt.io/vm=basic-vm
Step 2: Check the VM's network interface

VM_POD=$(oc get pods -l kubevirt.io/vm=basic-vm -o jsonpath='{.items[0].metadata.name}')
oc exec $VM_POD -- ip addr show
Step 3: Verify the VM's IP address

oc get vmi basic-vm -o jsonpath='{.status.interfaces[0].ipAddress}'
Task 2: Configure Multus CNI for Multi-homed VMs
Subtask 2.1: Verify Multus Installation
Step 1: Check if Multus is available in the cluster

oc get pods -n openshift-multus
Step 2: Verify Multus configuration

oc get network-attachment-definitions --all-namespaces
Subtask 2.2: Create Network Attachment Definitions
Step 1: Create a bridge Network Attachment Definition

cat > bridge-nad.yaml << 'EOF'
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: bridge-network
  namespace: vm-networking-lab
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "bridge-network",
      "type": "bridge",
      "bridge": "br1",
      "ipam": {
        "type": "static"
      }
    }
EOF
Step 2: Apply the bridge NAD

oc apply -f bridge-nad.yaml
Step 3: Create a macvlan Network Attachment Definition

cat > macvlan-nad.yaml << 'EOF'
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: macvlan-network
  namespace: vm-networking-lab
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "macvlan-network",
      "type": "macvlan",
      "master": "eth0",
      "mode": "bridge",
      "ipam": {
        "type": "static"
      }
    }
EOF
Step 4: Apply the macvlan NAD

oc apply -f macvlan-nad.yaml
Step 5: Verify the NADs were created

oc get network-attachment-definitions -n vm-networking-lab
Subtask 2.3: Create a Multi-homed VM
Step 1: Create a VM with multiple network interfaces

cat > multihomed-vm.yaml << 'EOF'
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: multihomed-vm
  namespace: vm-networking-lab
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: multihomed-vm
      annotations:
        k8s.v1.cni.cncf.io/networks: bridge-network,macvlan-network
    spec:
      domain:
        devices:
          disks:
          - name: containerdisk
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            masquerade: {}
          - name: bridge-net
            bridge: {}
          - name: macvlan-net
            bridge: {}
        resources:
          requests:
            memory: 1Gi
            cpu: 1
      networks:
      - name: default
        pod: {}
      - name: bridge-net
        multus:
          networkName: bridge-network
      - name: macvlan-net
        multus:
          networkName: macvlan-network
      volumes:
      - name: containerdisk
        containerDisk:
          image: quay.io/kubevirt/cirros-container-disk-demo
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            password: fedora
            chpasswd: { expire: False }
            ssh_pwauth: True
EOF
Step 2: Apply the multi-homed VM configuration

oc apply -f multihomed-vm.yaml
Step 3: Wait for the VM to start

oc get vm multihomed-vm
oc get vmi multihomed-vm
Subtask 2.4: Configure Static IP Addresses
Step 1: Create a NAD with static IP configuration

cat > static-ip-nad.yaml << 'EOF'
apiVersion: k8s.cni.cncf.io/v1
kind: NetworkAttachmentDefinition
metadata:
  name: static-ip-network
  namespace: vm-networking-lab
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "name": "static-ip-network",
      "type": "bridge",
      "bridge": "br2",
      "ipam": {
        "type": "static",
        "addresses": [
          {
            "address": "192.168.100.10/24"
          }
        ]
      }
    }
EOF
Step 2: Apply the static IP NAD

oc apply -f static-ip-nad.yaml
Step 3: Create a VM with static IP

cat > static-ip-vm.yaml << 'EOF'
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: static-ip-vm
  namespace: vm-networking-lab
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: static-ip-vm
      annotations:
        k8s.v1.cni.cncf.io/networks: static-ip-network
    spec:
      domain:
        devices:
          disks:
          - name: containerdisk
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            masquerade: {}
          - name: static-net
            bridge: {}
        resources:
          requests:
            memory: 1Gi
            cpu: 1
      networks:
      - name: default
        pod: {}
      - name: static-net
        multus:
          networkName: static-ip-network
      volumes:
      - name: containerdisk
        containerDisk:
          image: quay.io/kubevirt/cirros-container-disk-demo
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            password: fedora
            chpasswd: { expire: False }
            ssh_pwauth: True
            write_files:
            - path: /etc/sysconfig/network-scripts/ifcfg-eth1
              content: |
                DEVICE=eth1
                BOOTPROTO=static
                IPADDR=192.168.100.10
                NETMASK=255.255.255.0
                ONBOOT=yes
            runcmd:
            - ifup eth1
EOF
Step 4: Apply the static IP VM

oc apply -f static-ip-vm.yaml
Task 3: Verify Network Connectivity Between VMs and Services
Subtask 3.1: Test VM-to-VM Connectivity
Step 1: Get IP addresses of all VMs

