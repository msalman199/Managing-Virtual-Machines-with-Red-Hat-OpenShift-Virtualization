Advanced Migration Scenarios
Scenario 1: Scheduled Migration
Create automated migration policies for maintenance scenarios.

cat << EOF | oc apply -f -
apiVersion: kubevirt.io/v1
kind: MigrationPolicy
metadata:
  name: maintenance-migration-policy
spec:
  selectors:
    namespaceSelector:
      matchLabels:
        migration-policy: "maintenance"
    virtualMachineInstanceSelector:
      matchLabels:
        workload-type: "production"
  allowAutoConverge: true
  bandwidthPerMigration: "128Mi"
  completionTimeoutPerGiB: 600
EOF
Scenario 2: Emergency Migration
Handle urgent migration scenarios with priority settings.

cat << EOF | oc apply -f -
apiVersion: kubevirt.io/v1
kind: VirtualMachineInstanceMigration
metadata:
  name: emergency-migration
spec:
  vmiName: migration-test-vm
  priority: 1000
EOF
