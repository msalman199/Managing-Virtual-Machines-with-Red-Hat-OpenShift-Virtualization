Subtask 3.4: Performance Benchmarking
Create a comprehensive performance test for migration scenarios.

Create a migration performance test script:
cat << 'EOF' > migration-perf-test.sh
#!/bin/bash

VM_NAME="perf-test-vm"
RESULTS_FILE="migration-results.txt"

echo "Migration Performance Test Results" > $RESULTS_FILE
echo "=================================" >> $RESULTS_FILE
echo "Test Date: $(date)" >> $RESULTS_FILE
echo "" >> $RESULTS_FILE

# Function to create test VM
create_test_vm() {
    local vm_name=$1
    local memory_size=$2
    
    cat << EOF | oc apply -f -
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: ${vm_name}
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: ${vm_name}
    spec:
      domain:
        cpu:
          cores: 2
        devices:
          disks:
          - disk:
              bus: virtio
            name: containerdisk
        resources:
          requests:
            memory: ${memory_size}
      volumes:
      - containerDisk:
          image: quay.io/kubevirt/fedora-cloud-container-disk-demo
        name: containerdisk
EOF
}

# Function to measure migration time
measure_migration() {
    local vm_name=$1
    local test_name=$2
    
    echo "Starting migration test: $test_name"
    
    # Wait for VM to be ready
    oc wait --for=condition=Ready vmi/$vm_name --timeout=300s
    
    # Record start time
    START_TIME=$(date +%s)
    
    # Start migration
    virtctl migrate $vm_name
    
    # Wait for migration to complete
    while oc get vmim -l kubevirt.io/vmi-name=$vm_name | grep -q Running; do
        sleep 1
    done
    
    # Record end time
    END_TIME=$(date +%s)
    DURATION=$((END_TIME - START_TIME))
    
    echo "$test_name: ${DURATION}s" >> $RESULTS_FILE
    
    # Clean up migration objects
    oc delete vmim -l kubevirt.io/vmi-name=$vm_name
    
    echo "Migration completed in ${DURATION} seconds"
}

# Test different VM sizes
echo "Testing migration performance with different VM sizes..."

# Small VM test
create_test_vm "small-vm" "1Gi"
measure_migration "small-vm" "Small VM (1Gi RAM)"
oc delete vm small-vm

# Medium VM test
create_test_vm "medium-vm" "2Gi"
measure_migration "medium-vm" "Medium VM (2Gi RAM)"
oc delete vm medium-vm

# Large VM test
create_test_vm "large-vm" "4Gi"
measure_migration "large-vm" "Large VM (4Gi RAM)"
oc delete vm large-vm

echo "Performance testing completed. Results saved to $RESULTS_FILE"
cat $RESULTS_FILE
EOF

chmod +x migration-perf-test.sh
Run the performance test:
./migration-perf-test.sh
