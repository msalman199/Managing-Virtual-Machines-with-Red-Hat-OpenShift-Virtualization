Batch Migration Script
For migrating multiple VMs:

#!/bin/bash
# batch-migrate.sh

VMS=("vm1" "vm2" "vm3")
SOURCE_NAMESPACE="production"
DEST_NAMESPACE="production"

for vm in "${VMS[@]}"; do
    echo "Migrating $vm..."
    
    # Stop VM
    virtctl stop $vm -n $SOURCE_NAMESPACE
    
    # Export configuration
    oc get vm $vm -n $SOURCE_NAMESPACE -o yaml > /tmp/${vm}-export.yaml
    
    # Clean up export
    sed -i '/resourceVersion:/d' /tmp/${vm}-export.yaml
    sed -i '/uid:/d' /tmp/${vm}-export.yaml
    
    # Switch to destination cluster
    oc login --token=$DEST_CLUSTER_TOKEN --server=$DEST_CLUSTER_URL
    
    # Import VM
    oc apply -f /tmp/${vm}-export.yaml -n $DEST_NAMESPACE
    
    # Start VM
    virtctl start $vm -n $DEST_NAMESPACE
    
    echo "Migration of $vm completed"
done
