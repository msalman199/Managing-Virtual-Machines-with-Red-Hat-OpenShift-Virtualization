Troubleshooting Common Issues
Issue 1: VM Fails to Start on Destination Cluster
Symptoms: VM remains in "Pending" or "Failed" state

Solutions:

# Check VM events
oc describe vm migration-test-vm

# Check VMI events
oc describe vmi migration-test-vm

# Common fixes:
# 1. Storage class compatibility
oc get storageclass
oc patch vm migration-test-vm -p '{"spec":{"template":{"spec":{"volumes":[{"name":"containerdisk","containerDisk":{"image":"quay.io/kubevirt/cirros-container-disk-demo"}}]}}}}'

# 2. Resource constraints
oc describe nodes | grep -A 5 "Allocated resources"
Issue 2: Network Connectivity Problems
Symptoms: VM starts but has no network access

Solutions:

# Check network policies
oc get networkpolicy -n vm-migration-test

# Verify CNI configuration
oc get network.operator cluster -o yaml

# Check VM network configuration
oc get vmi migration-test-vm -o yaml | grep -A 20 networks
