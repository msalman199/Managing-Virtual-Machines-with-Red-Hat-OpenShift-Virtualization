Task 2: Migrate VMs Between Clusters Using virtctl
Subtask 2.1: Prepare Source VM for Migration
Step 1: Create a Test VM on Source Cluster

# Switch to source cluster
oc login --token=$SOURCE_CLUSTER_TOKEN --server=$SOURCE_CLUSTER_URL

# Create a namespace for our migration test
oc new-project vm-migration-test

# Create a test VM
cat << EOF > /tmp/test-vm.yaml
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: migration-test-vm
  namespace: vm-migration-test
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: migration-test-vm
    spec:
      domain:
        devices:
          disks:
          - disk:
              bus: virtio
            name: containerdisk
          - disk:
              bus: virtio
            name: cloudinitdisk
          interfaces:
          - masquerade: {}
            name: default
        resources:
          requests:
            memory: 1Gi
            cpu: 1
      networks:
      - name: default
        pod: {}
      volumes:
      - name: containerdisk
        containerDisk:
          image: quay.io/kubevirt/cirros-container-disk-demo
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            password: fedora
            chpasswd: { expire: False }
            ssh_pwauth: True
EOF

oc apply -f /tmp/test-vm.yaml
Step 2: Verify VM is Running and Create Test Data

# Wait for VM to be ready
oc get vm migration-test-vm -w

# Get VM status
oc get vmi migration-test-vm

# Connect to VM and create test data
virtctl console migration-test-vm

# Inside the VM, create a test file
echo "This is test data for migration" > /tmp/migration-test.txt
ls -la /tmp/migration-test.txt
exit
Step 3: Stop the VM for Migration

