Task 1: Create a Snapshot of a Running VM
Subtask 1.1: Verify VM Status and Prepare Environment
First, let's check the available virtual machines and their current status.

Connect to your lab environment and open a terminal

List all virtual machines in your namespace:

oc get vms -n default
Check the status of running VMs:
oc get vmis -n default
Create a test file in the VM (if VM is accessible via SSH):
# First, get the VM's IP address
oc get vmis test-vm -o jsonpath='{.status.interfaces[0].ipAddress}'

# SSH into the VM (replace IP_ADDRESS with actual IP)
ssh cloud-user@IP_ADDRESS

# Create a test file to verify snapshot functionality
echo "This file was created before snapshot" > /home/cloud-user/before-snapshot.txt
date >> /home/cloud-user/before-snapshot.txt
exit
Subtask 1.2: Create VM Snapshot Using CLI
Create a snapshot YAML definition:
cat > vm-snapshot.yaml << EOF
apiVersion: snapshot.kubevirt.io/v1beta1
kind: VirtualMachineSnapshot
metadata:
  name: test-vm-snapshot-$(date +%Y%m%d-%H%M%S)
  namespace: default
spec:
  source:
    apiVersion: kubevirt.io/v1
    kind: VirtualMachine
    name: test-vm
EOF
Apply the snapshot configuration:
oc apply -f vm-snapshot.yaml
Monitor snapshot creation progress:
# Check snapshot status
oc get vmsnapshot -n default

# Get detailed information about the snapshot
oc describe vmsnapshot $(oc get vmsnapshot -o name | head -1 | cut -d'/' -f2) -n default
Wait for snapshot completion:
# Monitor until status shows "Succeeded"
watch -n 5 "oc get vmsnapshot -n default"
Subtask 1.3: Verify Snapshot Creation
List all snapshots:
oc get vmsnapshot -n default -o wide
Check snapshot content details:
oc get vmsnapshotcontent -n default
Verify storage snapshot creation:
# Check if volume snapshots were created
oc get volumesnapshot -n default
Task 2: Restore the VM from a Snapshot
Subtask 2.1: Modify VM State Before Restoration
Make changes to the VM to demonstrate restoration:
# SSH back into the VM
ssh cloud-user@IP_ADDRESS

# Create a new file to show it will be lost after restoration
echo "This file was created AFTER snapshot" > /home/cloud-user/after-snapshot.txt
date >> /home/cloud-user/after-snapshot.txt

# Modify the original file
echo "Modified after snapshot creation" >> /home/cloud-user/before-snapshot.txt

# List files to confirm changes
ls -la /home/cloud-user/
cat /home/cloud-user/before-snapshot.txt
exit
Subtask 2.2: Create VM Restore Configuration
Stop the VM before restoration:
# Stop the virtual machine
oc patch vm test-vm --type merge -p '{"spec":{"running":false}}' -n default

# Wait for VM to stop
oc get vmis -n default
Create a restore YAML definition:
# Get the snapshot name
SNAPSHOT_NAME=$(oc get vmsnapshot -o jsonpath='{.items[0].metadata.name}' -n default)

cat > vm-restore.yaml << EOF
apiVersion: snapshot.kubevirt.io/v1beta1
kind: VirtualMachineRestore
metadata:
  name: test-vm-restore-$(date +%Y%m%d-%H%M%S)
  namespace: default
spec:
  target:
    apiVersion: kubevirt.io/v1
    kind: VirtualMachine
    name: test-vm
  virtualMachineSnapshotName: ${SNAPSHOT_NAME}
EOF
Subtask 2.3: Execute VM Restoration
Apply the restore configuration:
oc apply -f vm-restore.yaml
Monitor restoration progress:
# Check restore status
oc get vmrestore -n default

# Get detailed restoration information
oc describe vmrestore $(oc get vmrestore -o name | head -1 | cut -d'/' -f2) -n default
Wait for restoration completion:
# Monitor until status shows "Succeeded"
watch -n 5 "oc get vmrestore -n default"
Subtask 2.4: Verify Restoration Success
Start the restored VM:
oc patch vm test-vm --type merge -p '{"spec":{"running":true}}' -n default
Wait for VM to be ready:
oc get vmis -n default
Verify restoration by checking files:
# SSH into the restored VM
ssh cloud-user@IP_ADDRESS

# Check if the file created before snapshot exists
cat /home/cloud-user/before-snapshot.txt

# Verify the file created after snapshot is gone
ls -la /home/cloud-user/after-snapshot.txt

# List all files to confirm state
ls -la /home/cloud-user/
exit
Task 3: Automate Snapshot Creation Using Cron Jobs and Scripts
Subtask 3.1: Create Snapshot Automation Script
Create a snapshot automation script:
cat > snapshot-automation.sh << 'EOF'
#!/bin/bash

# VM Snapshot Automation Script
# This script creates snapshots of specified VMs with timestamp

# Configuration
NAMESPACE="default"
VM_NAME="test-vm"
SNAPSHOT_PREFIX="auto-snapshot"
MAX_SNAPSHOTS=5

# Function to log messages
log_message() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

# Function to create snapshot
create_snapshot() {
    local vm_name=$1
    local snapshot_name="${SNAPSHOT_PREFIX}-${vm_name}-$(date +%Y%m%d-%H%M%S)"
    
    log_message "Creating snapshot: $snapshot_name for VM: $vm_name"
    
    cat > /tmp/snapshot-${snapshot_name}.yaml << EOL
apiVersion: snapshot.kubevirt.io/v1beta1
kind: VirtualMachineSnapshot
metadata:
  name: ${snapshot_name}
  namespace: ${NAMESPACE}
  labels:
    automated: "true"
    vm-name: "${vm_name}"
spec:
  source:
    apiVersion: kubevirt.io/v1
    kind: VirtualMachine
    name: ${vm_name}
EOL

    # Apply the snapshot
    if oc apply -f /tmp/snapshot-${snapshot_name}.yaml; then
        log_message "Snapshot creation initiated successfully: $snapshot_name"
        rm -f /tmp/snapshot-${snapshot_name}.yaml
        return 0
    else
        log_message "ERROR: Failed to create snapshot: $snapshot_name"
        return 1
    fi
}

# Function to cleanup old snapshots
cleanup_old_snapshots() {
    local vm_name=$1
    
    log_message "Cleaning up old snapshots for VM: $vm_name"
    
    # Get snapshots sorted by creation time (oldest first)
    local snapshots=$(oc get vmsnapshot -n $NAMESPACE \
        -l automated=true,vm-name=$vm_name \
        --sort-by=.metadata.creationTimestamp \
        -o jsonpath='{.items[*].metadata.name}')
    
    local snapshot_array=($snapshots)
    local snapshot_count=${#snapshot_array[@]}
    
    if [ $snapshot_count -gt $MAX_SNAPSHOTS ]; then
        local snapshots_to_delete=$((snapshot_count - MAX_SNAPSHOTS))
        log_message "Found $snapshot_count snapshots, deleting oldest $snapshots_to_delete"
        
        for ((i=0; i<snapshots_to_delete; i++)); do
            local snapshot_to_delete=${snapshot_array[$i]}
            log_message "Deleting old snapshot: $snapshot_to_delete"
            oc delete vmsnapshot $snapshot_to_delete -n $NAMESPACE
        done
    else
        log_message "Snapshot count ($snapshot_count) is within limit ($MAX_SNAPSHOTS)"
    fi
}

# Main execution
main() {
    log_message "Starting automated snapshot process"
    
    # Check if VM exists
    if ! oc get vm $VM_NAME -n $NAMESPACE >/dev/null 2>&1; then
        log_message "ERROR: VM $VM_NAME not found in namespace $NAMESPACE"
        exit 1
    fi
    
    # Create snapshot
    if create_snapshot $VM_NAME; then
        # Wait a moment for snapshot to be registered
        sleep 10
        
        # Cleanup old snapshots
        cleanup_old_snapshots $VM_NAME
        
        log_message "Automated snapshot process completed successfully"
    else
        log_message "ERROR: Automated snapshot process failed"
        exit 1
    fi
}

# Execute main function
main "$@"
EOF
Make the script executable:
chmod +x snapshot-automation.sh
Test the automation script:
./snapshot-automation.sh
Subtask 3.2: Create Kubernetes CronJob for Automation
Create a ConfigMap for the script:
oc create configmap snapshot-script --from-file=snapshot-automation.sh -n default
Create a CronJob YAML definition:
cat > snapshot-cronjob.yaml << EOF
apiVersion: batch/v1
kind: CronJob
metadata:
  name: vm-snapshot-automation
  namespace: default
spec:
  schedule: "0 2 * * *"  # Run daily at 2 AM
  jobTemplate:
    spec:
      template:
        spec:
          serviceAccountName: snapshot-automation-sa
          containers:
          - name: snapshot-automation
            image: registry.redhat.io/ubi8/ubi:latest
            command:
            - /bin/bash
            - /scripts/snapshot-automation.sh
            volumeMounts:
            - name: script-volume
              mountPath: /scripts
            env:
            - name: KUBECONFIG
              value: /var/run/secrets/kubernetes.io/serviceaccount/token
          volumes:
          - name: script-volume
            configMap:
              name: snapshot-script
              defaultMode: 0755
          restartPolicy: OnFailure
EOF
Create necessary RBAC resources:
cat > snapshot-rbac.yaml << EOF
apiVersion: v1
kind: ServiceAccount
metadata:
  name: snapshot-automation-sa
  namespace: default
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: default
  name: snapshot-automation-role
rules:
- apiGroups: [""]
  resources: ["pods", "configmaps"]
  verbs: ["get", "list", "create", "update", "patch", "delete"]
- apiGroups: ["kubevirt.io"]
  resources: ["virtualmachines", "virtualmachineinstances"]
  verbs: ["get", "list"]
- apiGroups: ["snapshot.kubevirt.io"]
  resources: ["virtualmachinesnapshots", "virtualmachinesnapshotcontents", "virtualmachinerestores"]
  verbs: ["get", "list", "create", "update", "patch", "delete"]
- apiGroups: ["snapshot.storage.k8s.io"]
  resources: ["volumesnapshots", "volumesnapshotcontents"]
  verbs: ["get", "list", "create", "update", "patch", "delete"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: snapshot-automation-binding
  namespace: default
subjects:
- kind: ServiceAccount
  name: snapshot-automation-sa
  namespace: default
roleRef:
  kind: Role
  name: snapshot-automation-role
  apiGroup: rbac.authorization.k8s.io
EOF
Apply RBAC and CronJob configurations:
oc apply -f snapshot-rbac.yaml
oc apply -f snapshot-cronjob.yaml
