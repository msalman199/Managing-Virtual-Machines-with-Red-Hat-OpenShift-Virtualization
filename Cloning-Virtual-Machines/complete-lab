Task 5: Advanced Cloning Scenarios and Troubleshooting
Subtask 5.1: Clone Running VMs with Snapshots
Create a snapshot of a running VM:

cat << EOF > vm-snapshot.yaml
apiVersion: snapshot.kubevirt.io/v1alpha1
kind: VirtualMachineSnapshot
metadata:
  name: rhel8-base-snapshot
  namespace: default
spec:
  source:
    apiGroup: kubevirt.io
    kind: VirtualMachine
    name: rhel8-base
EOF
Apply the snapshot:

oc apply -f vm-snapshot.yaml
Wait for snapshot completion:

oc get vmsnapshot rhel8-base-snapshot -w
Clone from snapshot:

cat << EOF > clone-from-snapshot.yaml
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: rhel8-snapshot-clone
  namespace: default
spec:
  dataVolumeTemplates:
  - metadata:
      name: rhel8-snapshot-clone-rootdisk
    spec:
      source:
        snapshot:
          name: rhel8-base-snapshot
          namespace: default
      pvc:
        accessModes:
        - ReadWriteOnce
        resources:
          requests:
            storage: 20Gi
        storageClassName: local-path
  running: false
  template:
    metadata:
      labels:
        kubevirt.io/vm: rhel8-snapshot-clone
    spec:
      domain:
        cpu:
          cores: 2
        memory:
          guest: 4Gi
        devices:
          disks:
          - name: rootdisk
            disk:
              bus: virtio
      volumes:
      - name: rootdisk
        dataVolume:
          name: rhel8-snapshot-clone-rootdisk
EOF
Create the snapshot-based clone:

oc apply -f clone-from-snapshot.yaml
