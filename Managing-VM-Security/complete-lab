Subtask 3.3: Implement Storage Access Controls with Secrets
We'll use Kubernetes secrets to manage encryption keys and access credentials.

Create Encryption Key Secret
# Generate a random encryption key
ENCRYPTION_KEY=$(openssl rand -base64 32)

# Create secret for encryption key
oc create secret generic vm-encryption-key \
  --from-literal=key="$ENCRYPTION_KEY" \
  -n vm-security-lab

# Label the secret for easy identification
oc label secret vm-encryption-key security-level=high -n vm-security-lab
Create Database Credentials Secret
# Create database credentials
oc create secret generic database-credentials \
  --from-literal=username=dbadmin \
  --from-literal=password=$(openssl rand -base64 16) \
  --from-literal=root-password=$(openssl rand -base64 16) \
  -n vm-security-lab

# Label the secret
oc label secret database-credentials app=database-vm -n vm-security-lab
Create RBAC for Secret Access
# secret-access-rbac.yaml
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  namespace: vm-security-lab
  name: secret-reader
rules:
- apiGroups: [""]
  resources: ["secrets"]
  resourceNames: ["database-credentials", "vm-encryption-key"]
  verbs: ["get", "list"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: vm-secret-access
  namespace: vm-security-lab
subjects:
- kind: ServiceAccount
  name: vm-operator-sa
  namespace: vm-security-lab
- kind: ServiceAccount
  name: vm-admin-sa
  namespace: vm-security-lab
roleRef:
  kind: Role
  name: secret-reader
  apiGroup: rbac.authorization.k8s.io
Apply the secret access RBAC:

oc apply -f secret-access-rbac.yaml
Subtask 3.4: Create Secure VM with Encrypted Storage
Now let's create a VM that uses encrypted storage and secure credentials.

Create a Secure Database VM
# secure-database-vm.yaml
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: secure-database-vm
  namespace: vm-security-lab
  labels:
    vm-type: database
    security-zone: secure
    security-level: high
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: secure-database-vm
        vm-type: database
        security-zone: secure
        security-level: high
    spec:
      domain:
        devices:
          disks:
          - name: containerdisk
            disk:
              bus: virtio
          - name: encrypted-storage
            disk:
              bus: virtio
          - name: cloudinitdisk
            disk:
              bus: virtio
          interfaces:
          - name: default
            masquerade: {}
        resources:
          requests:
            memory: 2Gi
            cpu: 2
      networks:
      - name: default
        pod: {}
      volumes:
      - name: containerdisk
        containerDisk:
          image: quay.io/kubevirt/fedora-cloud-container-disk-demo
      - name: encrypted-storage
        persistentVolumeClaim:
          claimName: database-storage
      - name: cloudinitdisk
        cloudInitNoCloud:
          userData: |
            #cloud-config
            password: fedora
            chpasswd: { expire: False }
            packages:
              - mysql-server
              - cryptsetup
            write_files:
            - path: /etc/mysql/mysql.conf.d/security.cnf
              content: |
                [mysqld]
                ssl-ca=/etc/mysql/ca-cert.pem
                ssl-cert=/etc/mysql/server-cert.pem
                ssl-key=/etc/mysql/server-key.pem
                require_secure_transport=ON
                validate_password.policy=STRONG
            runcmd:
              - systemctl enable mysqld
              - systemctl start mysqld
              - mkdir -p /encrypted-data
              - mount /dev/vdb /encrypted-data
              - chown mysql:mysql /encrypted-data
              - mysql -e "CREATE USER 'dbadmin'@'%' IDENTIFIED BY 'SecurePass123!'"
              - mysql -e "GRANT ALL PRIVILEGES ON *.* TO 'dbadmin'@'%' WITH GRANT OPTION"
              - mysql -e "FLUSH PRIVILEGES"
Apply the secure database VM:

oc apply -f secure-database-vm.yaml
Subtask 3.5: Implement Storage Monitoring and Auditing
Let's set up monitoring for our encrypted storage.

Create a Storage Monitor ConfigMap
# storage-monitor-config.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: storage-monitor-config
  namespace: vm-security-lab
data:
  monitor.sh: |
    #!/bin/bash
    while true; do
      echo "$(date): Checking storage access for VMs"
      kubectl get pvc -n vm-security-lab -o wide
      kubectl get events -n vm-security-lab --field-selector reason=VolumeMount
      sleep 300
    done
  audit.sh: |
    #!/bin/bash
    echo "Storage Audit Report - $(date)"
    echo "================================"
    echo "Encrypted PVCs:"
    kubectl get pvc -n vm-security-lab -l security-level=high
    echo ""
    echo "Secret Access:"
    kubectl get rolebindings -n vm-security-lab -o wide
    echo ""
    echo "VM Storage Usage:"
    kubectl get vmis -n vm-security-lab -o custom-columns=NAME:.metadata.name,VOLUMES:.spec.volumes[*].name
Apply the storage monitor config:

oc apply -f storage-monitor-config.yaml
Create a Monitoring Pod
# storage-monitor-pod.yaml
apiVersion: v1
kind: Pod
metadata:
  name: storage-monitor
  namespace: vm-security-lab
  labels:
    app: storage-monitor
spec:
  serviceAccountName: vm-admin-sa
  containers:
  - name: monitor
    image: bitnami/kubectl:latest
    command: ["/bin/bash"]
    args: ["/scripts/monitor.sh"]
    volumeMounts:
    - name: scripts
      mountPath: /scripts
  volumes:
  - name: scripts
    configMap:
      name: storage-monitor-config
      defaultMode: 0755
  restartPolicy: Always
Apply the monitoring pod:

oc apply -f storage-monitor-pod.yaml
