    - protocol: TCP
      port: 443
  - from:
    - podSelector:
        matchLabels:
          role: admin
    ports:
    - protocol: TCP
      port: 22
  egress:
  - to:
    - podSelector:
        matchLabels:
          vm-type: database
    ports:
    - protocol: TCP
      port: 3306
    - protocol: TCP
      port: 5432
  - to: []
    ports:
    - protocol: UDP
      port: 53
    - protocol: TCP
      port: 53
    - protocol: TCP
      port: 80
    - protocol: TCP
      port: 443
Apply the web server policy:

