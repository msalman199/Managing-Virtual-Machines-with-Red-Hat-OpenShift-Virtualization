Task 2: Use oc adm top to monitor VM resource usage
Subtask 2.1: Monitor Node Resource Usage
Check overall node resource consumption:
oc adm top nodes
Get detailed node information with labels:
oc adm top nodes --show-labels
Monitor nodes continuously:
watch -n 5 'oc adm top nodes'
Subtask 2.2: Monitor Pod Resource Usage for VMs
List all pods with resource usage:
oc adm top pods --all-namespaces
Filter VM-related pods:
oc adm top pods --all-namespaces | grep virt-launcher
Monitor specific VM pod resources:
VM_POD=$(oc get pods -l kubevirt.io/vm=monitoring-test-vm -o jsonpath='{.items[0].metadata.name}')
oc adm top pod $VM_POD
Get detailed resource information for VM pods:
oc adm top pods --containers --all-namespaces | grep virt-launcher
Subtask 2.3: Create Resource Monitoring Script
Create a comprehensive monitoring script:
cat << 'EOF' > vm-resource-monitor.sh
#!/bin/bash

echo "=== Virtual Machine Resource Monitor ==="
echo "Timestamp: $(date)"
echo

echo "=== Node Resource Usage ==="
oc adm top nodes
echo

echo "=== VM Pod Resource Usage ==="
oc adm top pods --all-namespaces | grep virt-launcher
echo

echo "=== VM Status ==="
oc get vm --all-namespaces
echo

echo "=== VMI Resource Details ==="
for vmi in $(oc get vmi --all-namespaces -o jsonpath='{.items[*].metadata.name}'); do
    namespace=$(oc get vmi $vmi --all-namespaces -o jsonpath='{.items[0].metadata.namespace}')
    echo "VMI: $vmi (Namespace: $namespace)"
    oc get vmi $vmi -n $namespace -o jsonpath='{.spec.domain.resources}' | jq .
    echo
done

echo "=== Storage Usage ==="
oc get pvc --all-namespaces | grep -E "(vm-|vmi-)"
echo

echo "=== Network Usage ==="
oc get pods --all-namespaces -l kubevirt.io/vm -o wide
EOF

chmod +x vm-resource-monitor.sh
Run the monitoring script:
./vm-resource-monitor.sh
Set up periodic monitoring:
# Run every 60 seconds and log to file
while true; do
    echo "=== $(date) ===" >> vm-monitor.log
    ./vm-resource-monitor.sh >> vm-monitor.log
    sleep 60
done &
Subtask 2.4: Analyze Resource Trends
Create a resource usage analysis script:
cat << 'EOF' > analyze-vm-resources.sh
#!/bin/bash

echo "=== VM Resource Analysis ==="

# Get VM resource requests and limits
echo "VM Resource Requests and Limits:"
oc get vm --all-namespaces -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.template.spec.domain.resources}{"\n"}{end}' | column -t

# Calculate resource utilization
echo -e "\nCurrent Resource Utilization:"
for pod in $(oc get pods --all-namespaces -l kubevirt.io/vm -o jsonpath='{.items[*].metadata.name}'); do
    namespace=$(oc get pod $pod --all-namespaces -o jsonpath='{.items[0].metadata.namespace}')
    echo "Pod: $pod"
    oc adm top pod $pod -n $namespace --containers
    echo
done

# Check for resource pressure
echo "Node Resource Pressure:"
oc describe nodes | grep -A 5 "Conditions:"
EOF

chmod +x analyze-vm-resources.sh
./analyze-vm-resources.sh
Task 3: Configure alerts for VM health issues
Subtask 3.1: Create PrometheusRule for VM Alerts
Create VM health monitoring rules:
cat << EOF | oc apply -f -
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: vm-health-alerts
  namespace: openshift-monitoring
  labels:
    app: vm-monitoring
spec:
  groups:
  - name: vm.health
    rules:
    - alert: VMHighCPUUsage
      expr: rate(kubevirt_vmi_cpu_usage_seconds_total[5m]) * 100 > 80
      for: 5m
      labels:
        severity: warning
        service: kubevirt
      annotations:
        summary: "High CPU usage on VM {{ \$labels.name }}"
        description: "VM {{ \$labels.name }} has been using more than 80% CPU for more than 5 minutes."
    
    - alert: VMHighMemoryUsage
      expr: (kubevirt_vmi_memory_used_bytes / kubevirt_vmi_memory_available_bytes) * 100 > 85
      for: 5m
      labels:
        severity: warning
        service: kubevirt
      annotations:
        summary: "High memory usage on VM {{ \$labels.name }}"
        description: "VM {{ \$labels.name }} is using more than 85% of available memory."
    
    - alert: VMDown
      expr: up{job="kubevirt-vmi"} == 0
      for: 1m
      labels:
        severity: critical
        service: kubevirt
      annotations:
        summary: "VM {{ \$labels.name }} is down"
        description: "VM {{ \$labels.name }} has been down for more than 1 minute."
    
    - alert: VMDiskSpaceHigh
      expr: kubevirt_vmi_storage_used_bytes / kubevirt_vmi_storage_capacity_bytes * 100 > 90
      for: 10m
      labels:
        severity: critical
        service: kubevirt
      annotations:
        summary: "VM {{ \$labels.name }} disk space is critically high"
        description: "VM {{ \$labels.name }} disk usage is above 90% for more than 10 minutes."
EOF
Verify the PrometheusRule was created:
oc get prometheusrule vm-health-alerts -n openshift-monitoring
Check if the rules are loaded in Prometheus:
oc port-forward -n openshift-monitoring svc/prometheus-k8s 9090:9090 &
# Access http://localhost:9090/rules to see the loaded rules
Subtask 3.2: Configure AlertManager for Notifications
Create AlertManager configuration:
cat << EOF | oc apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-vm-config
  namespace: openshift-monitoring
type: Opaque
stringData:
  alertmanager.yml: |
    global:
      smtp_smarthost: 'localhost:587'
      smtp_from: 'alerts@example.com'
    
    route:
      group_by: ['alertname', 'service']
      group_wait: 10s
      group_interval: 10s
      repeat_interval: 1h
      receiver: 'vm-alerts'
      routes:
      - match:
          service: kubevirt
        receiver: 'vm-critical-alerts'
    
    receivers:
    - name: 'vm-alerts'
      webhook_configs:
      - url: 'http://webhook-receiver:8080/webhook'
        send_resolved: true
    
    - name: 'vm-critical-alerts'
      webhook_configs:
      - url: 'http://webhook-receiver:8080/critical'
        send_resolved: true
      email_configs:
      - to: 'admin@example.com'
        subject: 'Critical VM Alert: {{ .GroupLabels.alertname }}'
        body: |
          {{ range .Alerts }}
          Alert: {{ .Annotations.summary }}
          Description: {{ .Annotations.description }}
          {{ end }}
EOF
Create a simple webhook receiver for testing:
cat << EOF | oc apply -f -
apiVersion: apps/v1
kind: Deployment
metadata:
  name: webhook-receiver
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: webhook-receiver
  template:
    metadata:
      labels:
        app: webhook-receiver
    spec:
      containers:
      - name: webhook
        image: python:3.9-slim
        ports:
        - containerPort: 8080
        command:
        - python
        - -c
        - |
          from http.server import HTTPServer, BaseHTTPRequestHandler
          import json
          import sys
          
          class WebhookHandler(BaseHTTPRequestHandler):
              def do_POST(self):
                  content_length = int(self.headers['Content-Length'])
                  post_data = self.rfile.read(content_length)
                  
                  print(f"Received alert: {post_data.decode('utf-8')}")
                  
                  self.send_response(200)
                  self.send_header('Content-type', 'application/json')
                  self.end_headers()
                  self.wfile.write(b'{"status": "ok"}')
          
          server = HTTPServer(('0.0.0.0', 8080), WebhookHandler)
          print("Webhook server starting on port 8080")
          server.serve_forever()
---
apiVersion: v1
kind: Service
metadata:
  name: webhook-receiver
  namespace: default
spec:
  selector:
    app: webhook-receiver
  ports:
  - port: 8080
    targetPort: 8080
EOF
