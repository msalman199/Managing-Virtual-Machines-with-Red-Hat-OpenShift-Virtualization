{
  "dashboard": {
    "id": null,
    "title": "Virtual Machine Monitoring",
    "tags": ["kubevirt", "vm"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "VM CPU Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(kubevirt_vmi_cpu_usage_seconds_total[5m]) * 100",
            "legendFormat": "{{name}} CPU %"
          }
        ],
        "yAxes": [
          {
            "label": "CPU Percentage",
            "max": 100,
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "VM Memory Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "kubevirt_vmi_memory_used_bytes / kubevirt_vmi_memory_available_bytes * 100",
            "legendFormat": "{{name}} Memory %"
          }
        ],
        "yAxes": [
          {
            "label": "Memory Percentage",
            "max": 100,
            "min": 0
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s"
  }
}
